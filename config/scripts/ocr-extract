#!/usr/bin/env bash
# ──────────────────────────────────────────────
#   OCR text extraction
#   Selects a screen region with slurp, runs tesseract on the
#   captured PNG, copies the recognized text to the clipboard,
#   and shows a desktop notification with the result.
# ──────────────────────────────────────────────

set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:$PATH"
TESSERACT="$(command -v tesseract 2>/dev/null || command -v tesseract-ocr 2>/dev/null || echo tesseract)"

# ── Lock: only one OCR session at a time ─────────────────────────────────────
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/ocr-extract.lock"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    exit 0   # already running — silently ignore the extra key press
fi
# lock is held until the script exits (fd 9 closes)

TMP_PNG="$(mktemp -t ocr-XXXXXX.png)"
trap 'rm -f "$TMP_PNG"' EXIT

notify-send -u low -a "ocr" "OCR" "Draw a region to extract text…" 9>&-

GEOM="$(slurp -d 2>/dev/null || true)"
if [[ -z "$GEOM" ]]; then
    exit 0
fi

if ! grim -g "$GEOM" "$TMP_PNG" 2>/dev/null; then
    exit 0
fi

TEXT="$("$TESSERACT" "$TMP_PNG" stdout -l "${VOID_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null | sed -e 's/[[:space:]]\+$//' -e '/^$/d' || true)"

if [[ -z "$TEXT" ]]; then
    wl-copy --clear 9>&- 2>/dev/null || true
    notify-send "OCR" "No text detected" -u low 9>&-
    exit 0
fi

# Close lock fd (9) so wl-copy's background clipboard daemon does not inherit and hold ocr-extract.lock
printf '%s' "$TEXT" | wl-copy 9>&-

PREVIEW="$(printf '%s' "$TEXT" | head -c 200)"
[[ ${#TEXT} -gt 200 ]] && PREVIEW="${PREVIEW}…"
[[ -z "$PREVIEW" ]] && PREVIEW="(${#TEXT} chars)"

notify-send -u low "OCR — copied to clipboard" -- "$PREVIEW" 9>&-
