#!/usr/bin/env bash
# ffd — fuzzy find files with fzf + bat preview, delete after confirmation
# Usage: ffd [fzf-extra-args...]

set -euo pipefail

if command -v bat >/dev/null 2>&1; then
  PREVIEW='bat --color=always {}'
else
  PREVIEW='cat {}'
fi

mapfile -t files < <(fzf -m --preview="$PREVIEW" "$@")

if [ ${#files[@]} -gt 0 ]; then
  echo "Delete:"
  for f in "${files[@]}"; do
    echo "  $f"
  done
  read -r -p "Confirm? [y/N] " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    rm -rf "${files[@]}"
    echo "Deleted."
  else
    echo "Aborted."
  fi
fi
