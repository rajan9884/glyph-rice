#!/usr/bin/env python3
# cava with dots, like Nothing's Glyph Matrix: terminal cava only draws bars, so we take
# raw numbers and render the "●" matrix ourselves. Audio & smoothing — from nearby config. Exit — Ctrl+C
import configparser, os, shutil, subprocess, sys, tempfile

CONFIG = os.path.join(os.path.dirname(os.path.realpath(__file__)), "config")
ON, OFF = "●", "\x1b[90m●\x1b[39m"  # off dot — gray color8 of theme (bright in light theme), like an off matrix LED


def run(cols, rows):
    cfg = configparser.ConfigParser(interpolation=None, strict=False)
    cfg.read(CONFIG)
    cfg.remove_section("output")
    cfg.read_dict({
        # dot + space: terminal cell is twice narrower than line height, making grid square
        # even: stereo cava (by default) does not accept odd number of bars
        "general": {"bars": str(cols // 4 * 2)},
        "output": {"method": "raw", "raw_target": "/dev/stdout", "data_format": "ascii",
                   "ascii_max_range": str(rows), "bar_delimiter": "59", "frame_delimiter": "10"},
    })
    with tempfile.NamedTemporaryFile("w", suffix=".conf") as f:
        cfg.write(f)
        f.flush()
        with subprocess.Popen(["cava", "-p", f.name], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as p:
            sys.stdout.write("\x1b[2J")  # window resized — without this old frame would linger on bottom/right
            for line in p.stdout:
                if shutil.get_terminal_size() != (cols, rows):
                    p.terminate()
                    return True  # window size changed — re-render for new dimensions
                try:
                    v = [int(x) for x in line.strip().split(";") if x]
                except ValueError:
                    continue  # before error cava writes window title (\e]0;cava\a) to stdout — not a frame, error below
                rows_out = (" ".join(ON if h >= r else OFF for h in v) for r in range(rows, 0, -1))
                sys.stdout.write("\x1b[H" + "\n".join(rows_out))
                sys.stdout.flush()
            sys.exit(p.stderr.read() or None)  # cava crashed — show why once screen restored


if sys.argv[1:]:
    os.execvp("cava", ["cava", *sys.argv[1:]])  # with flags (cava -v, -p …) — standard cava

sys.stdout.write("\x1b[?1049h\x1b[?25l")  # alternate screen, cursor hidden
try:
    while run(*shutil.get_terminal_size()):
        pass
except KeyboardInterrupt:
    pass
finally:
    sys.stdout.write("\x1b[?25h\x1b[?1049l")
