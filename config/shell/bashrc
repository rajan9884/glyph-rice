# .bashrc - Interactive Bash configuration (shared helpers live in ~/.config/shell/aliases)

# Shared environment
if [ -f "$HOME/.config/shell/env.sh" ]; then
  source "$HOME/.config/shell/env.sh"
fi

# If not running interactively, return early
[[ $- != *i* ]] && return

# Hyprland launches GUI apps with cwd=/ — start interactive shells in $HOME
[[ "$PWD" == "/" ]] && cd "$HOME" >/dev/null 2>&1 || true

# FZF key bindings & completion (Bash)
[ -f /usr/share/fzf/key-bindings.bash ] && source /usr/share/fzf/key-bindings.bash
[ -f /usr/share/fzf/completion.bash ] && source /usr/share/fzf/completion.bash

# Starship Prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Common Shell Aliases & Shared Functions
if [ -f "$HOME/.bash_aliases" ]; then
  source "$HOME/.bash_aliases"
elif [ -f "$HOME/.config/shell/aliases" ]; then
  source "$HOME/.config/shell/aliases"
fi

# Dual-GitHub helpers
[ -f "$HOME/.config/shell/git-accounts.sh" ] && source "$HOME/.config/shell/git-accounts.sh"

# Direnv
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

# Bash-specific interactive helpers
sff() {
  if [ $# -eq 0 ]; then
    echo "Usage: sff <destination> (e.g. sff host:/tmp/)"
    return 1
  fi
  local file
  file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | command ff --select) && [ -n "$file" ] && scp "$file" "$1"
}

# Zoxide (cd replaces cd command, with z/zi aliases)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
  alias z=cd
  alias zi=cdi
fi
