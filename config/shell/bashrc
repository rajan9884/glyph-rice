# .bashrc - Ported shell config (Void-specific aliases removed)

# Shared environment
if [ -f "$HOME/.config/shell/env.sh" ]; then
  source "$HOME/.config/shell/env.sh"
fi

# If not running interactively, return early
[[ $- != *i* ]] && return

# FZF key bindings & completion (Bash)
[[ -n "$BASH_VERSION" ]] && {
  [[ -f /usr/share/fzf/key-bindings.bash ]] && source /usr/share/fzf/key-bindings.bash
  [[ -f /usr/share/fzf/completion.bash ]] && source /usr/share/fzf/completion.bash
}

# Starship Prompt
if [[ -n "$BASH_VERSION" ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash --print-full-init)"
fi

# Common Shell Aliases
if [ -f "$HOME/.bash_aliases" ]; then
  source "$HOME/.bash_aliases"
elif [ -f "$HOME/.config/shell/aliases" ]; then
  source "$HOME/.config/shell/aliases"
fi

# Dual-GitHub helpers if present
[ -f "$HOME/.config/shell/git-accounts.sh" ] && source "$HOME/.config/shell/git-accounts.sh"

# Bash-specific interactive helpers
if [[ -n "$BASH_VERSION" ]]; then
  if [[ "$TERM" == "xterm-kitty" ]]; then
    alias ff="fzf --preview 'case \$(file --mime-type -b {}) in image/*) kitty icat --clear --transfer-mode=memory --stdin=no --place=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 {} ;; *) bat --style=numbers --color=always {} ;; esac'"
  else
    alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
  fi
  alias eff='$EDITOR "$(ff)"'
  sff() { if [ $# -eq 0 ]; then echo "Usage: sff <destination> (e.g. sff host:/tmp/)"; return 1; fi; local file; file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) && [ -n "$file" ] && scp "$file" "$1"; }

  # Yazi file manager wrapper
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

# Zoxide (cd replaces cd command, with z/zi aliases)
if [[ -n "$BASH_VERSION" ]] && command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
  alias z=cd
  alias zi=cdi
fi
