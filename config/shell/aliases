# Common Shell Aliases (Shared across Bash & Zsh)

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# File system (eza)
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto'
  alias ll='eza -lah --icons=auto --git'
  alias la='eza -a --icons=auto'
  alias lsa='eza -a -lh --group-directories-first --icons=auto'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi
alias l='ls'
alias lla='ll -a'

# Development & Tools
alias ld='lazydocker'
alias t='tmux attach || tmux new -s Work'
alias lg='lazygit'
alias top='btop'
alias v='nvim'
alias zed='zed-editor'

if command -v rice >/dev/null 2>&1; then
  alias qs='rice'
fi

# cava with dots like Glyph Matrix (~/.config/cava/dots); regular bars — command cava
if command -v cava >/dev/null 2>&1 && [ -f "$HOME/.config/cava/dots" ]; then
  alias cava="$HOME/.config/cava/dots"
fi

n() {
  if [ "$#" -eq 0 ]; then
    command nvim .
  else
    command nvim "$@"
  fi
}

open() (
  xdg-open "$@" >/dev/null 2>&1 &
)

# Git
alias g='git'
alias ga='git add .'
alias gb='git branch'
alias gbd='git branch -d'
alias gc='git commit -am'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'
alias gco='git checkout'
alias gd='git diff'
alias gl='git log'
alias gp='git push'
alias gpl='git pull'
alias gs='git status'
alias gsh='git show'
alias gsp='git stash pop'
alias gst='git stash'
alias gsw='git switch'
alias gsm='git switch main'
