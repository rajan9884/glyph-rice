# .zshrc - Ported shell config (Void-specific aliases removed)

# Shared environment
if [ -f "$HOME/.config/shell/env.sh" ]; then
  source "$HOME/.config/shell/env.sh"
fi

# If not running interactively, return early
[[ $- != *i* ]] && return

# Common Aliases (shared with .bashrc / .bash_aliases)
if [ -f "$HOME/.bash_aliases" ]; then
  source "$HOME/.bash_aliases"
elif [ -f "$HOME/.config/shell/aliases" ]; then
  source "$HOME/.config/shell/aliases"
fi

# Dual-GitHub helpers if present
if [ -f "$HOME/.config/shell/git-accounts.sh" ]; then
  source "$HOME/.config/shell/git-accounts.sh"
fi

# Starship Prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Hyprland launches GUI apps with cwd=/ — never start an interactive shell at /
[[ "$PWD" == "/" ]] && cd "$HOME" >/dev/null 2>&1 || true

# Aliases & Functions (Interactive Zsh)
unalias ff ffd 2>/dev/null
ff() {
  local files=(${(f)"$(fzf -m --preview='bat --color=always {}')"})
  (( $#files )) && nvim $files
}

ffd() {
  local files=(${(f)"$(fzf -m --preview='bat --color=always {}')"})
  (( $#files )) && { echo "Delete: $files"; read -q "?Confirm? "; echo; rm -rf $files }
}

fcs() {
  command fcs "$@"
}

# Monochrome eza
export EZA_COLORS="uu=bright-black:gu=bright-black:da=bright-black:ur=white:uw=bright-black:ux=white:ue=bright-black:gr=bright-black:gw=bright-black:gx=white:tr=bright-black:fi=white:di=bright-white:ln=bright-black:pi=bright-black:so=bright-black:bd=bright-black:cd=bright-black:or=bright-black:mi=bright-black:ex=white"

# FZF key bindings & completion (Zsh)
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh

if command -v atuin >/dev/null 2>&1; then eval "$(atuin init zsh --disable-up-arrow)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook zsh)"; fi

# Yazi helper
y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  command yazi "$@" --cwd-file="$tmp"
  local cwd="$(cat -- "$tmp" 2>/dev/null)"
  rm -f -- "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && cd -- "$cwd"
}

# Desktop info on login
command -v fastfetch >/dev/null 2>&1 && fastfetch

# Completion
if [ -d /usr/share/zsh/site-functions ]; then
  fpath=(/usr/share/zsh/site-functions $fpath)
fi
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors \
  '=(#b)*(=0)=38;5;250' \
  '=(#b)*(=1)=38;5;255' \
  '=(#b)*(=2)=38;5;245' \
  '=(#b)*(=3)=38;5;240'

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# Zsh Autosuggestions
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
for p in /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  if [ -f "$p" ]; then
    source "$p"
    break
  fi
done

# Zsh Syntax Highlighting (must be loaded after compinit and autosuggestions)
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=white'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=white'
ZSH_HIGHLIGHT_STYLES[function]='fg=white'
ZSH_HIGHLIGHT_STYLES[alias]='fg=white'
ZSH_HIGHLIGHT_STYLES[path]='fg=245'
ZSH_HIGHLIGHT_STYLES[comment]='fg=240'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=245'

for p in /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
         /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  if [ -f "$p" ]; then
    source "$p"
    break
  fi
done

function fe() {
  local file
  if command -v bat >/dev/null 2>&1; then
    file=$(fzf --preview 'bat --color=always --style=numbers --line-range=:300 {}')
  else
    file=$(fzf)
  fi
  [ -n "$file" ] && "${EDITOR:-nvim}" "$file"
}

function fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m --header="Select process to kill" | awk '{print $2}')
  [ -n "$pid" ] && echo "$pid" | xargs kill -"${1:-9}"
}

# Zoxide (cd replaces cd command, with z/zi aliases)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
  alias z=cd
  alias zi=cdi
fi
