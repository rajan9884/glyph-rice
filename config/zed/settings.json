{
    "icon_theme": "Zed (Default)",
    "theme": {
        "mode": "system",
        "light": "Glyph Nothing Light",
        "dark": "Glyph Nothing"
    },
    "ui_font_family": "Space Grotesk",
    "ui_font_size": 15,
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 14,
    "vim_mode": true,
    "multi_cursor_modifier": "cmd_or_ctrl",
    "tab_size": 4,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "terminal": {
        "font_family": "JetBrainsMono Nerd Font",
        "font_weight": 400,
        "font_size": 13,
        "default_width": 200,
        "copy_on_select": true,
        "cursor_shape": "bar",
        "dock": "left"
    },
    "session": {
        "trust_all_worktrees": true
    },
    "project_panel": {
        "hide_hidden": false,
        "bold_folder_labels": false,
        "dock": "right",
        "hide_root": true,
        "auto_fold_dirs": false,
        "starts_open": false,
        "git_status": true,
        "sticky_scroll": false,
        "scrollbar": {
            "show": "never"
        },
        "indent_guides": {
            "show": "never"
        }
    },
    "edit_predictions": {
        "allow_data_collection": "no"
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "title_bar": {
        "show_onboarding_banner": false,
        "show_project_items": true
    }
}
